# Anthropic Claude API 키 (없어도 룰 기반 폴백으로 전체 흐름이 동작합니다)
# 발급: https://console.anthropic.com/  →  Vercel 배포 시 Environment Variables에 동일하게 등록
ANTHROPIC_API_KEY=sk-ant-...

# --- 비상연락처 실제 알림 발송 (선택) ---
# 아래 두 값이 모두 있어야 3차 검증에서 실제 이메일이 발송됩니다.
# 없으면 시뮬레이션으로 동작하며, 화면에 시뮬레이션임을 명시합니다.
# 발급: https://resend.com/  (무료 티어로 충분합니다)
RESEND_API_KEY=re_...
# Resend에서 인증한 도메인의 발신 주소. 도메인이 없으면 onboarding@resend.dev 로 테스트할 수 있습니다.
NOTIFY_FROM_EMAIL=피싱브레이크 <onboarding@resend.dev>
